{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": ".*\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "<rootDir>/../../tsconfig.server.json" }]
  },
  "collectCoverageFrom": ["**/*.(t|j)s", "!**/*.module.ts", "!main.ts"],
  "coverageDirectory": "../../coverage",
  "testEnvironment": "node"
}
