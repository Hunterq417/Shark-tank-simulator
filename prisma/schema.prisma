datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  FOUNDER
  SHARK
}

enum LiveStatus {
  UPCOMING
  LIVE
  PAUSED
  ENDED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
  WITHDRAWN
}

enum SenderRole {
  FOUNDER
  SHARK
  SYSTEM
}

enum NegotiationStatus {
  ACTIVE
  ACCEPTED
  REJECTED
}

enum DealStatus {
  CLOSED
  IN_TERM_SHEET
}

enum NotificationType {
  OFFER
  SYSTEM
  NEGOTIATION
  EVENT
}

enum TimelineCategory {
  OFFER
  COUNTER
  ACCEPTANCE
  PITCH
  QUEUE
  NEGOTIATION
}

enum QueueStatus {
  WAITING
  ACTIVE
  DONE
  SKIPPED
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  passwordHash       String
  name               String
  role               Role
  company            String?
  avatar             String?
  balance            String?   @default("$12,500,000")
  dealsClosed        Int       @default(0)
  refreshTokenHash   String?
  resetCode          String?
  resetCodeExpiresAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  founders      Founder[]
  sharks        Shark[]
  notifications Notification[]
  activityLogs  ActivityLog[]
  chatMessages  ChatMessage[]

  @@index([role])
}

model Startup {
  id             String   @id @default(uuid())
  name           String   @unique
  logo           String?
  sector         String
  stage          String
  description    String
  fundingAsk     String
  equityOffered  String
  valuation      String
  arr            String?
  clients        String?
  pitchDeckUrl   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  founders       Founder[]
  events         Event[]
  pitches        Pitch[]
  offers         Offer[]
  negotiations   Negotiation[]
  deals          Deal[]
  timelineEvents TimelineEvent[]
  queueEntries   PitchQueueEntry[]
}

model Founder {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startupId String?
  startup   Startup? @relation(fields: [startupId], references: [id], onDelete: SetNull)
  bio       String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([startupId])
}

model Shark {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fundName      String
  minTicket     String?  @default("$100K")
  maxTicket     String?  @default("$5M")
  escrowBalance String?  @default("$25,000,000")
  createdAt     DateTime @default(now())

  @@index([userId])
}

model Event {
  id           String     @id @default(uuid())
  title        String
  companyName  String
  pitchDeckUrl String?
  liveStatus   LiveStatus @default(UPCOMING)
  startTime    DateTime   @default(now())
  endedAt      DateTime?
  startupId    String
  startup      Startup    @relation(fields: [startupId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  pitches      Pitch[]
  queueEntries PitchQueueEntry[]

  @@index([liveStatus])
}

model Pitch {
  id                  String   @id @default(uuid())
  eventId             String
  event               Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  startupId           String
  startup             Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
  totalCommitted      String   @default("$850K")
  percentageCommitted Float    @default(57.0)
  videoUrl            String?
  transcript          String?
  createdAt           DateTime @default(now())

  @@index([eventId])
}

model PitchQueueEntry {
  id        String      @id @default(uuid())
  eventId   String
  event     Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  startupId String
  startup   Startup     @relation(fields: [startupId], references: [id], onDelete: Cascade)
  position  Int
  status    QueueStatus @default(WAITING)
  joinedAt  DateTime    @default(now())

  @@unique([eventId, startupId])
  @@index([eventId, position])
}

model Offer {
  id            String         @id @default(uuid())
  startupId     String
  startup       Startup        @relation(fields: [startupId], references: [id], onDelete: Cascade)
  sharkId       String?
  sharkName     String
  amount        String
  equity        String
  valuation     String?
  terms         String
  status        OfferStatus    @default(PENDING)
  withdrawnAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  counterOffers CounterOffer[]
  negotiations  Negotiation[]

  @@index([startupId])
  @@index([status])
}

model CounterOffer {
  id         String     @id @default(uuid())
  offerId    String
  offer      Offer      @relation(fields: [offerId], references: [id], onDelete: Cascade)
  senderRole SenderRole
  senderName String
  amount     String
  equity     String
  terms      String
  createdAt  DateTime   @default(now())

  @@index([offerId])
}

model Negotiation {
  id           String            @id @default(uuid())
  offerId      String
  offer        Offer             @relation(fields: [offerId], references: [id], onDelete: Cascade)
  startupId    String
  startup      Startup           @relation(fields: [startupId], references: [id], onDelete: Cascade)
  sharkId      String?
  status       NegotiationStatus @default(ACTIVE)
  roomCode     String            @default("ROOM-101")
  focusMode    Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  chatMessages ChatMessage[]

  @@index([roomCode])
  @@index([startupId])
}

model ChatMessage {
  id            String      @id @default(uuid())
  negotiationId String
  negotiation   Negotiation @relation(fields: [negotiationId], references: [id], onDelete: Cascade)
  senderId      String?
  sender        User?       @relation(fields: [senderId], references: [id], onDelete: SetNull)
  senderRole    SenderRole
  senderName    String
  text          String
  createdAt     DateTime    @default(now())

  @@index([negotiationId])
}

model Deal {
  id           String     @id @default(uuid())
  startupId    String
  startup      Startup    @relation(fields: [startupId], references: [id], onDelete: Cascade)
  sharkId      String?
  leadInvestor String
  dealSize     String
  valuation    String
  status       DealStatus @default(CLOSED)
  closedAt     DateTime   @default(now())

  @@index([startupId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  read      Boolean          @default(false)
  type      NotificationType
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([read])
}

model TimelineEvent {
  id          String           @id @default(uuid())
  startupId   String
  startup     Startup          @relation(fields: [startupId], references: [id], onDelete: Cascade)
  title       String
  description String
  timestamp   DateTime         @default(now())
  category    TimelineCategory

  @@index([startupId])
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String
  timestamp DateTime @default(now())

  @@index([userId])
}
