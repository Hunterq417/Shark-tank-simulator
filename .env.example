# Database Configuration
# Port 55432 (not 5432) avoids clashing with a native local Postgres install.
DATABASE_URL="postgresql://ventureflow:ventureflow_password@localhost:55432/ventureflow_db?schema=public"

# JWT Authentication Secrets
JWT_SECRET="change_me_jwt_secret"
JWT_EXPIRES_IN="1d"
REFRESH_SECRET="change_me_refresh_secret"
REFRESH_EXPIRES_IN="7d"

# Server Configuration
PORT=3000
NODE_ENV="development"

# CORS Configuration
CORS_ORIGIN="*"
